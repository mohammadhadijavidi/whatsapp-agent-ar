# ---------- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup) ----------
# Permanent token of a System User with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value in the webhook settings in the Meta dashboard
WHATSAPP_VERIFY_TOKEN=change-me-random-string
# App > Settings > Basic > App Secret. Used to verify X-Hub-Signature-256 (required)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
# 1 = never call Meta, store outgoing payloads locally (default when no access token is set)
WA_DRY_RUN=1

# ---------- Agent ----------
WA_BUSINESS_FILE=examples/clinic/business.json
WA_DB_PATH=whatsapp_agent.db
WA_REMINDER_TEMPLATE=appointment_reminder
WA_REMINDER_TEMPLATE_LANG=ar

# ---------- Optional LLM fallback (grounded; answers only from your business file) ----------
# mock | openai | openrouter | groq | ollama | lmstudio | anthropic
WA_LLM_PROVIDER=mock
WA_LLM_MODEL=
WA_LLM_BASE_URL=
WA_LLM_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Dashboard (HTTP Basic auth; set a password before exposing it) ----------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
